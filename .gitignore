Thumbs.db

# --- Databases ---
*.sqlite3
*.dump
*.backup

# --- Node (legacy tooling) ---
node_modules/

# Runtime settings store (created on first boot; may hold deployment config)
data/

# --- Runtime artifacts (audit session) ---
.pgdata/
.system_initialized
core/.app_instance.lock
sample_data/

# --- Scratch space for manual verification probes (not shipped) ---
.probe/
.test_runtime/
